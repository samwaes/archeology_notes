# Local development identity only. Production identity comes from Cloudflare Access headers.
ARCHEOLOGY_ACCESS_DEV_EMAIL=you@example.com

# Application
PORT=3000
NEXT_PUBLIC_APP_URL=https://archeology-notes.hupla.eu

# Shared Hupla central access and usage service.
HUPLA_ACCESS_API_URL=https://www.hupla.eu/api/access/v1
HUPLA_ACCESS_SERVICE_TOKEN=
HUPLA_ACCOUNT_URL=https://labs.hupla.eu/account
# Production should be true after the shared access integration has been verified.
HUPLA_ACCESS_FAIL_CLOSED=true

# PostgreSQL + PostGIS
DATABASE_URL=
ARCHEOLOGY_DATABASE_SSL=false

# Private Cloudflare R2 object storage.
# The browser should only receive short-lived signed URLs, never these credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=archeology-notes
# Optional. If omitted the standard Cloudflare R2 S3 endpoint is derived from R2_ACCOUNT_ID.
R2_ENDPOINT=

# Optional Phase 2 voice transcription. Original audio is always retained in R2.
# Leave TRANSCRIPTION_PROVIDER=disabled when no external transcription service should be called.
TRANSCRIPTION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional override for an approved regional OpenAI endpoint or compatible gateway.
OPENAI_API_BASE_URL=https://api.openai.com/v1
